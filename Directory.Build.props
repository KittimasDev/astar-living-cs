<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RollForward>latestMinor</RollForward>

    <!--
        เวอร์ชันของผลิตภัณฑ์ทั้งชุด (client + api + updater) อยู่ที่เดียวตรงนี้

        สั่งทับตอน build ได้ด้วย -p:Version=1.0.1 ซึ่งสายการปล่อยเวอร์ชันใช้อยู่
        บรรทัดแรกจำเป็นมาก ถ้าไม่มี ค่าที่สั่งทับจะถูกค่าคงที่ด้านล่างกลบ
        แล้วทุก build จะรายงานตัวเองว่าเป็น 1.0.0 ทำให้ระบบอัปเดตไม่มีวันเห็นเวอร์ชันใหม่
    -->
    <ProductVersion Condition="'$(ProductVersion)' == '' and '$(Version)' != ''">$(Version)</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>

    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductVersion).0</AssemblyVersion>
    <FileVersion>$(ProductVersion).0</FileVersion>

    <Company>A STAR TECHNOLOGY CO., LTD.</Company>
    <Product>A star Living</Product>
    <Copyright>Copyright © A STAR TECHNOLOGY CO., LTD.</Copyright>
  </PropertyGroup>
</Project>
