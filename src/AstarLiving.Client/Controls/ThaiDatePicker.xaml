<UserControl x:Class="AstarLiving.Client.Controls.ThaiDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:AstarLiving.Client.Common.Behaviors"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="DayBox" Grid.Column="0" Height="40"
                  Style="{StaticResource PillComboBox}"
                  b:Placeholder.Text="วัน"
                  SelectionChanged="OnPartChanged" />

        <ComboBox x:Name="MonthBox" Grid.Column="2" Height="40"
                  Style="{StaticResource PillComboBox}"
                  b:Placeholder.Text="เดือน"
                  SelectionChanged="OnPartChanged" />

        <ComboBox x:Name="YearBox" Grid.Column="4" Height="40"
                  Style="{StaticResource PillComboBox}"
                  b:Placeholder.Text="ปี พ.ศ."
                  SelectionChanged="OnPartChanged" />
    </Grid>
</UserControl>
