<!--
    ไอคอนทั้งหมดเป็นเส้นวาดในตัวโปรแกรม ไม่พึ่งฟอนต์ไอคอนของ Windows
    เพราะชุดไอคอนของ Windows 10 กับ 11 ไม่เหมือนกัน และเครื่องลูกค้ามีทั้งสองรุ่น
    ทุกเส้นวาดบนกรอบ 24x24 จึงปรับขนาดพร้อมกันได้ด้วย Width/Height เดียว
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ต้องรวม Tokens เข้ามาเอง ไม่ใช่พึ่งว่า Theme.xaml รวมให้แล้ว
        เพราะพจนานุกรมที่เป็นพี่น้องกันมองหาคีย์ข้ามกันไม่ได้ตอนโหลด
        ถ้าไม่ใส่ Setter ที่อ้าง StaticResource จะได้ค่า UnsetValue เงียบ ๆ
        แล้วไปพังตอนวัดขนาดหน้าจอแทน ซึ่งหาสาเหตุยากมาก
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

