    <!--
        รูปร่างของไอคอนเป็นเส้น ไม่ใช่พื้นทึบ จึงตั้ง Fill เป็นว่าง
        StrokeStartLineCap/EndLineCap แบบ Round ทำให้เส้นสั้น ๆ ไม่ดูขาดตอน
    -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
