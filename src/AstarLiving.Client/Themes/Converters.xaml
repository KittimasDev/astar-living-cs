<!--
    ตัวแปลงค่าที่ใช้ร่วมกันทั้งโปรแกรม
    แยกเป็นไฟล์ของตัวเองเพราะพจนานุกรมอื่นต้องรวมไฟล์นี้เข้าไปจึงจะอ้างถึงได้
    (พจนานุกรมที่เป็นพี่น้องกันมองหาคีย์ข้ามกันไม่ได้ตอนโหลด)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AstarLiving.Client.Common.Converters">

    <conv:IconLookupConverter x:Key="IconLookup" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToVisibility" />
    <conv:MoneyConverter x:Key="Money" />
    <conv:Money2Converter x:Key="Money2" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:AreEqualConverter x:Key="AreEqual" />
    <conv:RowNumberConverter x:Key="RowNumber" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:ImageSourceConverter x:Key="ImageSource" />

</ResourceDictionary>
