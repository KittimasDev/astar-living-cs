<!--
    หน้าตาของฟอร์มในหน้าต่างซ้อน แยกจาก DialogTemplates.xaml ที่เก็บเฉพาะกล่องมาตรฐาน
    ทุกฟอร์มใช้โครงเดียวกัน: หัวข้อกึ่งกลาง ตารางช่องกรอกสองคอลัมน์ ปุ่มกลางล่าง
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:AstarLiving.Client.Common.Behaviors"
                    xmlns:dlg="clr-namespace:AstarLiving.Client.ViewModels.Dialogs">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Inputs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/DataDisplay.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ช่องกรอกในฟอร์มมุมมนน้อยกว่าช่องค้นหา ตามที่เว็บเดิมตั้งไว้ -->
    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource PillTextBox}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ButtonRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{Binding Path=(b:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource PillComboBox}">
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- ── ฟอร์มลูกบ้าน ──────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type dlg:ResidentFormDialogViewModel}">
        <StackPanel Margin="40,32,40,32">
            <TextBlock Text="{Binding Title}"
                       FontSize="{StaticResource FontSizeLg}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- บ้านเลขที่ -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="บ้านเลขที่" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text=" *" Style="{StaticResource FieldLabel}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource FormTextBox}"
                             b:Placeholder.Text="กรอกบ้านเลขที่"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding HouseNo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldErrorText}" Margin="2,4,0,0"
                               Text="{Binding HouseNoError}"
                               Visibility="{Binding HouseNoError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <!-- ชื่อ - นามสกุล -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ชื่อ - นามสกุล" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text=" *" Style="{StaticResource FieldLabel}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource FormTextBox}"
                             b:Placeholder.Text="กรอกชื่อ - นามสกุล"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldErrorText}" Margin="2,4,0,0"
                               Text="{Binding FullNameError}"
                               Visibility="{Binding FullNameError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <!-- อัตราส่วนกรรมสิทธิ์ -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="อัตราส่วนกรรมสิทธิ์" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text=" *" Style="{StaticResource FieldLabel}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource FormTextBox}"
                             b:Placeholder.Text="กรอกอัตราส่วนกรรมสิทธิ์"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding OwnershipRatio, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldErrorText}" Margin="2,4,0,0"
                               Text="{Binding OwnershipRatioError}"
                               Visibility="{Binding OwnershipRatioError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <!-- เบอร์โทร -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="เบอร์โทร" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FormTextBox}"
                             b:Placeholder.Text="กรอกเบอร์โทร"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- อีเมล -->
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="อีเมล" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FormTextBox}"
                             b:Placeholder.Text="กรอกอีเมล"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- ที่อยู่ -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="ที่อยู่" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource MultilineTextBox}"
                             MinHeight="80"
                             b:Placeholder.Text="กรอกที่อยู่"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Border Background="#FFFFF1F0" BorderBrush="#FFFFCCC7" BorderThickness="1"
                    CornerRadius="8" Padding="14,10,14,10" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Button Content="ย้อนกลับ" Style="{StaticResource SecondaryButton}"
                        MinWidth="120" Height="40" Margin="0,0,12,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="{Binding SubmitText}" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Height="40"
                        Command="{Binding SubmitCommand}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
