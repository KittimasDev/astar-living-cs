<!--
    รวมพจนานุกรมธีมทั้งหมดไว้ที่เดียว หน้าจอไหนที่ต้องการธีมให้อ้างไฟล์นี้ไฟล์เดียว
    ลำดับสำคัญ: Tokens ต้องมาก่อนเสมอ เพราะสไตล์อื่นอ้าง StaticResource จากในนั้น
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AstarLiving.Client.Common.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Inputs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/DataDisplay.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/DialogTemplates.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/FormDialogTemplates.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SettingsFormTemplates.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/WizardTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ค่าเริ่มต้นของตัวอักษรทั้งโปรแกรม -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
    </Style>

</ResourceDictionary>
