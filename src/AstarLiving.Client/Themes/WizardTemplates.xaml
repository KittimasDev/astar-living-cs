<!--
    หน้าต่างซ้อนแบบหลายขั้นตอน: ออกใบเสร็จ ออกใบแจ้งหนี้ ใบแจ้งหนี้ล่วงหน้า และรายรับอื่น ๆ
    ทุกตัวใช้โครงเดียวกัน หัวข้อ เนื้อหาของขั้นปัจจุบัน แถบข้อผิดพลาด แล้วปุ่มท้าย
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:AstarLiving.Client.Common.Behaviors"
                    xmlns:ctl="clr-namespace:AstarLiving.Client.Controls"
                    xmlns:dlg="clr-namespace:AstarLiving.Client.ViewModels.Dialogs">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Inputs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/DataDisplay.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="WizardHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>

    <DataTemplate x:Key="WizardErrorBanner">
        <Border Background="#FFFFF1F0" BorderBrush="#FFFFCCC7" BorderThickness="1"
                CornerRadius="8" Padding="14,10,14,10" Margin="0,16,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>
    </DataTemplate>

    <!-- ── ขั้นตอนออกใบเสร็จค่าส่วนกลาง ─────────────────────────────────── -->
    <DataTemplate DataType="{x:Type dlg:ReceiptWizardDialogViewModel}">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="{Binding Title}" Style="{StaticResource WizardHeading}" />

            <ProgressBar Style="{StaticResource AppProgressRing}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- ขั้นที่ 1: เลือกบ้าน -->
            <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                <TextBox Style="{StaticResource PillTextBox}" Height="40" Margin="0,0,0,12"
                         b:Placeholder.Text="ค้นหาบ้านเลขที่หรือชื่อ"
                         Text="{Binding ResidentSearch, UpdateSourceTrigger=PropertyChanged}" />

                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                    <DataGrid Style="{StaticResource AppDataGrid}" Height="340"
                              ItemsSource="{Binding Residents}"
                              SelectedItem="{Binding SelectedResident}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="บ้านเลขที่" Binding="{Binding HouseNo}" Width="*" MinWidth="110" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="ชื่อ-นามสกุล" Binding="{Binding FullName}" Width="2*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="ที่อยู่" Binding="{Binding Address}" Width="2*" MinWidth="240" ElementStyle="{StaticResource LeftCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- ขั้นที่ 2: เลือกงวดและรายการย่อย -->
            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ResidentLabel}" FontWeight="Medium"
                           Foreground="{StaticResource DeepBlueBrush}" Margin="0,0,0,12" />

                <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,0,0,12"
                          Content="ใช้ส่วนลดรายปี (ระบบจะสร้างงวดล่วงหน้าเดือน 2-12 ให้อัตโนมัติ)"
                          IsChecked="{Binding UseDiscount}"
                          Visibility="{Binding DiscountAvailable, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Invoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16,12,16,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DeepBlueBrush}" />
                                                <TextBlock Text="{Binding InvoiceNo}" Style="{StaticResource MutedText}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right">
                                                <Run Text="เลือกแล้ว" />
                                                <Run Text="{Binding SelectedTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="บาท" />
                                            </TextBlock>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <CheckBox Style="{StaticResource AppCheckBox}"
                                                                  Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected}" />
                                                        <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,12,16,12" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="รวมที่เลือกไว้" FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource DeepBlueBrush}">
                            <Run Text="{Binding SelectedTotalText, Mode=OneWay}" />
                            <Run Text="บาท" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ขั้นที่ 3: สรุปยอด -->
            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                <DataGrid Style="{StaticResource AppDataGrid}" MaxHeight="360" ItemsSource="{Binding SummaryItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="รายการ" Binding="{Binding Name}" Width="3*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                        <DataGridTextColumn Header="จำนวนหน่วย" Binding="{Binding CountText}" Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="ราคาต่อหน่วย (บาท)" Binding="{Binding UnitPriceText}" Width="1.4*" MinWidth="160"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="รวมทั้งหมด (บาท)" Binding="{Binding Total, StringFormat={}{0:#,##0.00}}" Width="1.4*" MinWidth="160"
                                            ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Margin="0,12,0,0"
                      Visibility="{Binding SummaryHasDiscount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ส่วนลดรายปี" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource ActionGreenBrush}">
                        <Run Text="-" />
                        <Run Text="{Binding SummaryDiscountText, Mode=OneWay}" />
                        <Run Text="บาท" />
                    </TextBlock>
                </Grid>

                <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,14,16,14" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="ยอดที่ต้องชำระ" FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}"
                                   FontSize="{StaticResource FontSizeMd}" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                   Foreground="{StaticResource DeepBlueBrush}" FontSize="{StaticResource FontSizeMd}">
                            <Run Text="{Binding SummaryTotalText, Mode=OneWay}" />
                            <Run Text="บาท" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ขั้นที่ 4: วิธีชำระเงิน -->
            <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="วิธีการชำระเงิน" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                                  b:Placeholder.Text="เลือกวิธีการชำระเงิน"
                                  ItemsSource="{Binding PaymentMethods}"
                                  ItemTemplate="{StaticResource NameItemTemplate}"
                                  SelectedItem="{Binding SelectedMethod}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="วันที่ออกใบเสร็จ" Style="{StaticResource FieldLabel}" />
                        <ctl:ThaiDatePicker SelectedDate="{Binding IssueDate}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding NeedsBankName, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ธนาคาร" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource PillTextBox}" Height="40"
                             b:Placeholder.Text="กรอกชื่อธนาคาร"
                             Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding NeedsChequeNo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="เลขที่เช็ค" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource PillTextBox}" Height="40"
                             b:Placeholder.Text="กรอกเลขที่เช็ค"
                             Text="{Binding ChequeNo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="หมายเหตุ" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="70"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <ContentControl ContentTemplate="{StaticResource WizardErrorBanner}" Content="{Binding}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="ยกเลิก" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="ย้อนกลับ" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="130" Height="40"
                        Command="{Binding NextCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ถัดไป" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                        <Setter Property="Text" Value="ออกใบเสร็จ" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── ขั้นตอนออกใบแจ้งหนี้ทั้งงวด ───────────────────────────────────── -->
    <DataTemplate DataType="{x:Type dlg:InvoiceWizardDialogViewModel}">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="{Binding Title}" Style="{StaticResource WizardHeading}" />

            <ProgressBar Style="{StaticResource AppProgressRing}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- ขั้นที่ 1: ยืนยันงวด -->
            <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="10" Padding="24,20,24,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="งวดที่ระบบจะออกใบแจ้งหนี้ให้" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PeriodText}" FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold" Foreground="{StaticResource DeepBlueBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFF7E6" BorderBrush="#FFFFD591" BorderThickness="1"
                        CornerRadius="8" Padding="14,10,14,10" Margin="0,14,0,0"
                        Visibility="{Binding IsSupplement, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                               Text="งวดนี้เป็นการเติมใบแจ้งหนี้ย้อนหลังให้บ้านที่ยังไม่มีใบของงวดล่าสุด ไม่ใช่การออกงวดใหม่" />
                </Border>
            </StackPanel>

            <!-- ขั้นที่ 2: ตรวจรายการ -->
            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,10,16,10" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DeepBlueBrush}"
                               Text="ติ๊กเลือกบ้านที่ต้องการคิดค่าทวงถามในงวดนี้ ระบบตั้งต้นให้เฉพาะบ้านที่มีหนี้ค้าง" />
                </Border>

                <DataGrid Style="{StaticResource AppDataGrid}" MaxHeight="420" ItemsSource="{Binding PreviewItems}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="คิดค่าทวงถาม" Width="Auto" MinWidth="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource AppCheckBox}" HorizontalAlignment="Center"
                                              IsChecked="{Binding ChargeCollectionFee, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="บ้านเลขที่" Binding="{Binding HouseNo}" Width="*" MinWidth="110" ElementStyle="{StaticResource LeftCell}" />
                        <DataGridTextColumn Header="ชื่อ-นามสกุล" Binding="{Binding FullName}" Width="2*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                        <DataGridTextColumn Header="อัตราส่วน" Binding="{Binding OwnershipRatioText}" Width="Auto" MinWidth="110"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="ค่าส่วนกลาง" Binding="{Binding MaintenanceText}" Width="Auto" MinWidth="130"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="ค่าปรับ" Binding="{Binding FineText}" Width="Auto" MinWidth="110"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="ค่าทวงถาม" Binding="{Binding CollectionText}" Width="Auto" MinWidth="120"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="หนี้ค้าง" Binding="{Binding DebtTotalText}" Width="Auto" MinWidth="120"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="รวม (บาท)" Binding="{Binding TotalText}" Width="Auto" MinWidth="130"
                                            ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,12,16,12" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}">
                            <Run Text="ทั้งหมด" />
                            <Run Text="{Binding HouseCount, Mode=OneWay}" />
                            <Run Text="ใบ" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource DeepBlueBrush}">
                            <Run Text="{Binding GrandTotalText, Mode=OneWay}" />
                            <Run Text="บาท" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <ContentControl ContentTemplate="{StaticResource WizardErrorBanner}" Content="{Binding}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="ยกเลิก" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="ย้อนกลับ" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="150" Height="40"
                        Command="{Binding NextCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ตรวจสอบรายการ" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Text" Value="ออกใบแจ้งหนี้" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── ใบแจ้งหนี้ล่วงหน้า ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type dlg:AdvanceInvoiceDialogViewModel}">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="{Binding Title}" Style="{StaticResource WizardHeading}" />

            <ProgressBar Style="{StaticResource AppProgressRing}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="บ้าน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                              b:Placeholder.Text="เลือกบ้าน"
                              ItemsSource="{Binding Residents}"
                              SelectedItem="{Binding SelectedResident}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding HouseNo, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding FullName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ปี (พ.ศ.)" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                              ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding Year}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="เลือกเดือน" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
            <ItemsControl ItemsSource="{Binding Months}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource AppCheckBox}" Width="130" Margin="0,0,8,10"
                                  Content="{Binding MonthTh}"
                                  IsEnabled="{Binding CanSelect}"
                                  IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,12,16,12" Margin="0,8,0,0"
                    Visibility="{Binding PreviewLabel, Converter={StaticResource StringToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding PreviewLabel}" Foreground="{StaticResource DeepBlueBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontWeight="Bold" Foreground="{StaticResource DeepBlueBrush}">
                        <Run Text="รวม" />
                        <Run Text="{Binding PreviewTotalText, Mode=OneWay}" />
                        <Run Text="บาท" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="วิธีการชำระเงิน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                              ItemsSource="{Binding PaymentMethods}"
                              ItemTemplate="{StaticResource NameItemTemplate}"
                              SelectedItem="{Binding SelectedMethod}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="วันที่ออกเอกสาร" Style="{StaticResource FieldLabel}" />
                    <ctl:ThaiDatePicker SelectedDate="{Binding IssueDate}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="หมายเหตุ" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="70"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

            <ContentControl ContentTemplate="{StaticResource WizardErrorBanner}" Content="{Binding}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="ยกเลิก" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="ออกใบแจ้งหนี้ล่วงหน้า" Style="{StaticResource PrimaryButton}"
                        MinWidth="180" Height="40"
                        Command="{Binding SubmitCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── ใบเสร็จรายรับอื่น ๆ ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type dlg:RevenueFormDialogViewModel}">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="{Binding Title}" Style="{StaticResource WizardHeading}" />

            <ProgressBar Style="{StaticResource AppProgressRing}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="บ้าน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                              b:Placeholder.Text="เลือกบ้าน"
                              ItemsSource="{Binding Residents}"
                              SelectedItem="{Binding SelectedResident}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding HouseNo, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding FullName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="วิธีการชำระเงิน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Height="40"
                              ItemsSource="{Binding PaymentMethods}"
                              ItemTemplate="{StaticResource NameItemTemplate}"
                              SelectedItem="{Binding SelectedMethod}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="วันที่ออกเอกสาร" Style="{StaticResource FieldLabel}" />
                    <ctl:ThaiDatePicker SelectedDate="{Binding IssueDate}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <TextBlock Text="รายการ" Style="{StaticResource FieldLabel}" />
                <Button Style="{StaticResource LinkButton}" Content="+ เพิ่มบรรทัด"
                        Foreground="{StaticResource ActionGreenBrush}"
                        HorizontalAlignment="Right"
                        Command="{Binding AddItemCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource PillTextBox}" Height="40"
                                     b:Placeholder.Text="รายละเอียด"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="2" Style="{StaticResource PillTextBox}" Height="40"
                                     b:Placeholder.Text="จำนวน"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="4" Style="{StaticResource PillTextBox}" Height="40"
                                     b:Placeholder.Text="ราคาต่อหน่วย"
                                     Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Grid.Column="6" Background="{StaticResource TableHeaderBrush}"
                                    CornerRadius="20" Height="40">
                                <TextBlock Text="{Binding TotalText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,14,0"
                                           Foreground="{StaticResource DeepBlueBrush}" FontWeight="Medium" />
                            </Border>

                            <Button Grid.Column="7" Style="{StaticResource IconButton}" ToolTip="ลบบรรทัดนี้"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}"
                                      Stroke="{StaticResource DangerBrush}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource TableHeaderBrush}" CornerRadius="8" Padding="16,12,16,12" Margin="0,6,0,0">
                <Grid>
                    <TextBlock Text="ยอดรวม" FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource DeepBlueBrush}">
                        <Run Text="{Binding GrandTotalText, Mode=OneWay}" />
                        <Run Text="บาท" />
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding NeedsBankName, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ธนาคาร" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource PillTextBox}" Height="40"
                         b:Placeholder.Text="กรอกชื่อธนาคาร"
                         Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding NeedsChequeNo, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="เลขที่เช็ค" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource PillTextBox}" Height="40"
                         b:Placeholder.Text="กรอกเลขที่เช็ค"
                         Text="{Binding ChequeNo, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="หมายเหตุ" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="70"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

            <ContentControl ContentTemplate="{StaticResource WizardErrorBanner}" Content="{Binding}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="ยกเลิก" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Height="40" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="บันทึก" Style="{StaticResource PrimaryButton}"
                        MinWidth="130" Height="40"
                        Command="{Binding SubmitCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
