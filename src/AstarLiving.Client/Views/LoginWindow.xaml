<Window x:Class="AstarLiving.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="clr-namespace:AstarLiving.Client.Common.Behaviors"
        xmlns:vm="clr-namespace:AstarLiving.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="A star Living"
        Height="760" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AuthBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ภาพฝั่งซ้ายเต็มครึ่งจอ ตัดส่วนเกินเหมือน background-size: cover ของเว็บเดิม -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Image Source="pack://application:,,,/Assets/Images/auth-bg.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- ฟอร์มฝั่งขวา -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="420" Margin="40,48,40,48" VerticalAlignment="Center">

                    <Image Source="pack://application:,,,/Assets/Images/living-logo-login.png"
                           Width="180" Margin="0,0,0,24"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="เข้าสู่ระบบ"
                               FontSize="{StaticResource FontSizeDisplay}"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandBlueBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32" />

                    <!-- ชื่อผู้ใช้ -->
                    <StackPanel Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ชื่อผู้ใช้" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text=" *" Style="{StaticResource FieldLabel}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>

                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource PillTextBox}"
                                 b:Placeholder.Text="กรอกชื่อผู้ใช้"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldErrorText}"
                                   Text="{Binding UsernameError}"
                                   Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- รหัสผ่าน -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="รหัสผ่าน" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text=" *" Style="{StaticResource FieldLabel}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>

                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource PillPasswordBox}"
                                     b:Placeholder.Text="กรอกรหัสผ่าน"
                                     b:PasswordBoxBinder.Attach="True"
                                     b:PasswordBoxBinder.SecurePassword="{Binding Password, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource FieldErrorText}"
                                   Text="{Binding PasswordError}"
                                   Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- แถบข้อผิดพลาดจากเครื่องแม่ข่าย -->
                    <Border Background="#FFFFF1F0"
                            BorderBrush="#FFFFCCC7"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10,14,10"
                            Margin="0,14,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{StaticResource IconWarning}"
                                  Stroke="{StaticResource DangerBrush}"
                                  Width="16" Height="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,10,0" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="330" />
                        </StackPanel>
                    </Border>

                    <!-- ปุ่มเข้าสู่ระบบ -->
                    <Button Command="{Binding SignInCommand}"
                            IsDefault="True"
                            IsEnabled="{Binding IsWaitingForServer, Converter={StaticResource InverseBool}}"
                            Content="เข้าสู่ระบบ"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" MinWidth="170"
                            FontSize="{StaticResource FontSizeMd}"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0" />

                    <ProgressBar Style="{StaticResource AppProgressRing}"
                                 Width="170"
                                 Margin="0,12,0,0"
                                 Visibility="{Binding ShowBusyIndicator, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding BusyMessage}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="330"
                               Margin="0,8,0,0"
                               Visibility="{Binding ShowBusyIndicator, Converter={StaticResource BoolToVisibility}}" />

                    <!-- ที่อยู่เครื่องแม่ข่าย ให้ช่างตรวจได้ตอนติดตั้งหน้างาน -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,36,0,0">
                        <TextBlock Text="เครื่องแม่ข่าย:" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource MutedText}" Margin="6,0,10,0" />
                        <Button Content="เปลี่ยน"
                                Style="{StaticResource LinkButton}"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource BrandBlueBrush}"
                                Command="{Binding OpenServerSettingsCommand}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
