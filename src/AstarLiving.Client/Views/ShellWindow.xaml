<Window x:Class="AstarLiving.Client.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstarLiving.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="A star Living"
        Height="900" Width="1500"
        MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PageBackgroundBrush}">

    <Window.Resources>
        <!--
            ปุ่มเมนู: ปกติเทา เมื่อชี้หรือถูกเลือกเป็นน้ำเงินเข้ม ไอคอนเป็นฟ้าแบรนด์
            สีและพฤติกรรมตรงกับกฎ .ant-menu-item ใน globals.css ของเว็บเดิม
        -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,11,12,11"
                                Margin="0,2,0,2">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Icon"
                                      Style="{StaticResource IconPath}"
                                      Data="{Binding IconKey, Converter={StaticResource IconLookup}}"
                                      VerticalAlignment="Center" />
                                <TextBlock x:Name="Label"
                                           Text="{Binding Label}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Path x:Name="Chevron"
                                      Style="{StaticResource IconPath}"
                                      Data="{StaticResource IconChevronDown}"
                                      Width="14" Height="14"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="7" CenterY="7" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource BrandBlueBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource MenuSelectedBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource BrandBlueBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── แถบเมนูซ้าย ──────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource SidebarShadow}">
            <Grid Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="pack://application:,,,/Assets/Images/living-logo.png"
                       Height="130"
                       Margin="0,16,0,18"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button Style="{StaticResource MenuItemButton}"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />

                                    <ItemsControl ItemsSource="{Binding Children}"
                                                  Margin="14,0,0,4"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MenuItemButton}"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── ฝั่งขวา: หัว เนื้อหา ท้าย ─────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- หัวหน้าจอ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,14,24,14">
                <Grid>
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource PageTitle}"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Width="Auto" Height="Auto"
                                Command="{Binding ToggleUserMenuCommand}"
                                ToolTip="บัญชีผู้ใช้">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource TableHeaderBrush}">
                                    <Path Style="{StaticResource IconPath}"
                                          Data="{StaticResource IconUser}"
                                          Stroke="{StaticResource DeepBlueBrush}"
                                          Width="20" Height="20" />
                                </Border>

                                <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserDisplayName}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding UserRoleName}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <Path Style="{StaticResource IconPath}"
                                      Data="{StaticResource IconChevronDown}"
                                      Width="12" Height="12"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               HorizontalOffset="-110"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,6,0,0"
                                    Effect="{StaticResource CardShadow}">
                                <Button Command="{Binding SignOutCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="170">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}"
                                              Data="{StaticResource IconLogout}"
                                              Width="16" Height="16" />
                                        <TextBlock Text="ออกจากระบบ" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- เนื้อหาของหน้าที่เลือก -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="0" />

            <!-- ท้ายหน้าจอ: ลิขสิทธิ์ เวอร์ชัน และปุ่มตรวจสอบการอัปเดต -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="24,12,24,12">
                <Grid>
                    <TextBlock Text="{Binding FooterText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Button Style="{StaticResource LinkButton}"
                                Content="ตรวจสอบการอัปเดต"
                                Foreground="{StaticResource BrandBlueBrush}"
                                FontSize="{StaticResource FontSizeSm}"
                                Command="{Binding CheckForUpdatesCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ฉากคลุมตอนกำลังออกจากระบบ -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding IsSigningOut, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource ModalRadius}"
                        Padding="40,32,40,32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource ModalShadow}">
                    <StackPanel>
                        <ProgressBar Style="{StaticResource AppProgressRing}" Width="200" />
                        <TextBlock Text="กำลังออกจากระบบ กรุณารอสักครู่..."
                                   Margin="0,16,0,0"
                                   FontSize="{StaticResource FontSizeMd}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
        </Grid>

        <!--
            ชั้นหน้าต่างซ้อน: วาดทับทุกอย่างรวมถึงแถบเมนู เหมือน Modal ของเว็บเดิม
            รองรับการซ้อนหลายชั้น เช่น กล่องยืนยันออกทับฟอร์มที่กรอกค้างไว้
        -->
        <ItemsControl ItemsSource="{Binding Dialogs.Stack}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{StaticResource OverlayBrush}">
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="{StaticResource ModalRadius}"
                                Width="{Binding DialogWidth}"
                                MaxHeight="820"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Effect="{StaticResource ModalShadow}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter Content="{Binding}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
