<UserControl x:Class="AstarLiving.Client.Views.Pages.Settings.RateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:AstarLiving.Client.Controls"
             xmlns:pages="clr-namespace:AstarLiving.Client.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:RateSettingsPageViewModel}">

    <ctl:ListPageShell SearchPlaceholder="" CreateText="เพิ่มอัตราค่าบริการ" EmptyMessage="ยังไม่ได้ตั้งค่าอัตราค่าบริการ" ShowSearch="False">
        <ctl:ListPageShell.Table>
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ลำดับ" Width="Auto" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RowNumber}">
                                            <Binding />
                                            <Binding Path="DataContext.Items" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ค่าส่วนกลางต่อตารางวา" Binding="{Binding MaintenanceFeeRate, StringFormat={}{0:#,##0.##}}" Width="*" ElementStyle="{StaticResource NumberCell}" MinWidth="190" />
                    <DataGridTextColumn Header="ค่าเบี้ยปรับ (%)" Binding="{Binding FineRate, StringFormat={}{0:#,##0.##}}" Width="*" ElementStyle="{StaticResource NumberCell}" MinWidth="141" />
                    <DataGridTextColumn Header="ค่าทวงถามต่อเดือน" Binding="{Binding CollectionFee, StringFormat={}{0:#,##0.##}}" Width="*" ElementStyle="{StaticResource NumberCell}" MinWidth="164" />
                    <DataGridTextColumn Header="Prefix ใบแจ้งหนี้" Binding="{Binding InvoicePrefix}" Width="*" MinWidth="152" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Prefix ใบเสร็จ" Binding="{Binding ReceiptPrefix}" Width="*" MinWidth="138" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ส่วนลด (%)" Binding="{Binding DiscountRate, StringFormat={}{0:#,##0.##}}" Width="*" ElementStyle="{StaticResource NumberCell}" MinWidth="121" />
                    <DataGridTemplateColumn Header="สถานะการใช้งาน" Width="Auto" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveStatusPill}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="110" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" ToolTip="ดูรายละเอียด"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconView}"
                                              Stroke="{StaticResource DeepBlueBrush}" Width="17" Height="17" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="แก้ไข"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEdit}"
                                              Stroke="{StaticResource ActionGreenBrush}" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ctl:ListPageShell.Table>
    </ctl:ListPageShell>
</UserControl>
