<UserControl x:Class="AstarLiving.Client.Views.Pages.Settings.UserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:AstarLiving.Client.Controls"
             xmlns:pages="clr-namespace:AstarLiving.Client.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:UserSettingsPageViewModel}">

    <ctl:ListPageShell SearchPlaceholder="ค้นหาผู้ใช้งาน" CreateText="เพิ่มผู้ใช้งาน" EmptyMessage="ไม่มีผู้ใช้งาน">
        <ctl:ListPageShell.Table>
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ลำดับ" Width="Auto" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RowNumber}">
                                            <Binding />
                                            <Binding Path="DataContext.Items" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="รหัสผู้ใช้งาน" Binding="{Binding Id}" Width="Auto" MinWidth="123" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ชื่อเต็ม" Binding="{Binding FullName}" Width="1.8*" MinWidth="190" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="โครงการ" Binding="{Binding Project.Name}" Width="1.5*" MinWidth="190" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ชื่อผู้ใช้งาน" Binding="{Binding Username}" Width="*" MinWidth="150" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="สิทธิ์ผู้ใช้งาน" Binding="{Binding Role}" Width="*" MinWidth="150" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="อีเมล" Binding="{Binding Email}" Width="1.5*" MinWidth="220" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="เบอร์โทร" Binding="{Binding Phone}" Width="*" MinWidth="150" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTemplateColumn Header="สถานะการใช้งาน" Width="Auto" MinWidth="148">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveStatusPill}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="170" MinWidth="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" ToolTip="ดูรายละเอียด"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconView}"
                                              Stroke="{StaticResource DeepBlueBrush}" Width="17" Height="17" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="แก้ไข"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEdit}"
                                              Stroke="{StaticResource ActionGreenBrush}" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="รีเซ็ตรหัสผ่าน"
                                            Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}"
                                              Stroke="{StaticResource WarningBrush}" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="ลบ"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDelete}"
                                              Stroke="{StaticResource DangerBrush}" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ctl:ListPageShell.Table>
    </ctl:ListPageShell>
</UserControl>
