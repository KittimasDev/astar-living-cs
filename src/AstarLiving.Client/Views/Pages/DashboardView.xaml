<UserControl x:Class="AstarLiving.Client.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:AstarLiving.Client.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:DashboardPageViewModel}"
             Background="{StaticResource PageBackgroundBrush}">

    <UserControl.Resources>
        <!-- การ์ดกราฟใช้เงาฟ้าอ่อนเหมือนเว็บเดิม ไม่ใช่เงาเทามาตรฐาน -->
        <DropShadowEffect x:Key="BlueGlow" BlurRadius="12" ShadowDepth="4" Direction="270"
                          Opacity="0.3" Color="{StaticResource BrandBlueColor}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- ── ตัวกรอง ──────────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="ปี (พ.ศ.)" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}"
                              Width="120"
                              ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding SelectedYear}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="ตั้งแต่เดือน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}"
                              Width="150"
                              ItemsSource="{Binding Months}"
                              ItemTemplate="{StaticResource LabelItemTemplate}"
                              SelectedItem="{Binding SelectedStartMonth}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="ถึงเดือน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}"
                              Width="150"
                              ItemsSource="{Binding Months}"
                              ItemTemplate="{StaticResource LabelItemTemplate}"
                              SelectedItem="{Binding SelectedEndMonth}" />
                </StackPanel>

                <Button Style="{StaticResource IconButton}"
                        Command="{Binding LoadCommand}"
                        ToolTip="โหลดข้อมูลใหม่"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,3">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" />
                </Button>
            </StackPanel>

            <ProgressBar Style="{StaticResource AppProgressRing}"
                         Margin="0,0,0,10"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border Background="#FFFFF1F0" BorderBrush="#FFFFCCC7" BorderThickness="1"
                    CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- ── การ์ดตัวเลขสรุป ──────────────────────────────────────── -->
            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BrandBlueBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24,14,24,14"
                                Margin="0,0,12,12"
                                Effect="{StaticResource BlueGlow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeMd}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="{StaticResource FontSizeXl}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── กราฟ ─────────────────────────────────────────────────── -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- กราฟแนวโน้มรายเดือน -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Height="400"
                        Effect="{StaticResource BlueGlow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="กราฟแนวโน้ม (Monthly Trend)"
                                   FontSize="{StaticResource FontSizeLg}" />

                        <!-- คำอธิบายกราฟ -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource Chart1Brush}"
                                     Stroke="#FFD9D9D9" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="ชำระเงินแล้ว" Margin="6,0,20,0" VerticalAlignment="Center" />
                            <Ellipse Width="14" Height="14" Fill="{StaticResource Chart2Brush}"
                                     Stroke="#FFD9D9D9" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="ค้างชำระ" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock Text="ยังไม่มีข้อมูลในช่วงที่เลือก"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding MonthlyTrend.Count, Converter={StaticResource EmptyToVisibility}}" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MonthlyTrend}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center">
                                                    <!-- แท่งชำระแล้ว -->
                                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding PaidText}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,2" />
                                                        <Border Width="20"
                                                                Height="{Binding PaidHeight}"
                                                                Background="{StaticResource Chart1Brush}"
                                                                CornerRadius="8,8,0,0" />
                                                    </StackPanel>

                                                    <!-- แท่งค้างชำระ -->
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding UnpaidText}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,2" />
                                                        <Border Width="20"
                                                                Height="{Binding UnpaidHeight}"
                                                                Background="{StaticResource Chart2Brush}"
                                                                CornerRadius="8,8,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- วิธีการชำระเงิน -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Height="400"
                        Effect="{StaticResource BlueGlow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="วิธีการชำระเงิน" FontSize="{StaticResource FontSizeLg}" />

                        <!-- คำอธิบาย: วิธีที่ไม่มียอดจะจางลง ตามพฤติกรรมของเว็บเดิม -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding PaymentMethods}" Margin="0,10,0,12"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Ellipse Width="14" Height="14" Fill="{Binding Color}"
                                                 Stroke="#FFD9D9D9" StrokeThickness="1" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Margin="6,0,0,0"
                                                   FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Viewbox Grid.Row="2" Stretch="Uniform" Margin="0,4,0,0">
                            <Canvas Width="200" Height="200">
                                <!-- ชิ้นของวงแหวน พิกัดอยู่ในตัวรูปร่างอยู่แล้วจึงไม่ต้องจัดตำแหน่ง -->
                                <ItemsControl ItemsSource="{Binding PaymentMethods}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="200" Height="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Slice}"
                                                  Fill="{Binding Color}"
                                                  Stroke="White"
                                                  StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ตัวเลขกำกับกลางชิ้น: จำนวนใบเสร็จและสัดส่วน เหมือนกราฟของเว็บเดิม -->
                                <ItemsControl ItemsSource="{Binding PaymentMethods}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="200" Height="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding LabelPoint.X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding LabelPoint.Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- เลื่อนขึ้นซ้ายครึ่งหนึ่งของกล่อง เพื่อให้จุดอ้างอิงอยู่กึ่งกลางข้อความ -->
                                            <StackPanel Width="70" Margin="-35,-18,0,0"
                                                        Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ValueText}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ShareText}"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           Opacity="0.9"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── ตารางรายการค้างชำระ ───────────────────────────────────── -->
            <TextBlock Text="รายการ Outstandings" FontSize="{StaticResource FontSizeLg}" Margin="0,24,0,12" />

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{StaticResource AppDataGrid}"
                              ItemsSource="{Binding Outstandings}"
                              MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="บ้านเลขที่" Binding="{Binding HouseNo}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="ชื่อ-นามสกุล" Binding="{Binding FullName}" Width="*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="จำนวนเดือน" Binding="{Binding Count}" Width="Auto" MinWidth="124"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="ค่าปรับ (บาท)" Width="Auto" MinWidth="131"
                                                Binding="{Binding Fine, Converter={StaticResource Money}}"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="ค่าทวงถาม (บาท)" Width="Auto" MinWidth="153"
                                                Binding="{Binding CollectionFee, Converter={StaticResource Money}}"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="ยอดที่ต้องชำระ (บาท)" Width="Auto" MinWidth="176"
                                                Binding="{Binding TotalDue, Converter={StaticResource Money}}"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTemplateColumn Header="สถานะ" Width="Auto" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                    <Setter Property="Background" Value="#FF22C55E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ยังไม่ชำระเงิน">
                                                            <Setter Property="Background" Value="#FFCDCDCD" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Medium"
                                                       FontSize="{StaticResource FontSizeSm}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ชำระเงินแล้ว" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ยังไม่ชำระเงิน">
                                                                <Setter Property="Text" Value="ยังไม่ชำระเงิน" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="ไม่พบรายการค้างชำระ"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,60,0,40"
                               VerticalAlignment="Top"
                               Visibility="{Binding Outstandings.Count, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
