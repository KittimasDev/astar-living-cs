<UserControl x:Class="AstarLiving.Client.Views.Pages.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:AstarLiving.Client.Common.Behaviors"
             xmlns:ctl="clr-namespace:AstarLiving.Client.Controls"
             xmlns:pages="clr-namespace:AstarLiving.Client.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:InvoicePageViewModel}">

    <ctl:ListPageShell SearchPlaceholder="ค้นหาบ้านเลขที่"
                       CreateText="ออกใบแจ้งหนี้"
                       EmptyMessage="ยังไม่มีใบแจ้งหนี้">

        <ctl:ListPageShell.Filters>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="ปี (พ.ศ.)" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Width="130"
                              b:Placeholder.Text="ทุกปี"
                              ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding FilterYear}" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="เดือน" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource PillComboBox}" Width="160"
                              b:Placeholder.Text="ทุกเดือน"
                              ItemsSource="{Binding Months}"
                              SelectedItem="{Binding FilterMonth}" />
                </StackPanel>

                <!-- คำสั่งที่ทำกับทั้งงวด ต้องเลือกเดือนและปีก่อนจึงจะใช้ได้ -->
                <Button Style="{StaticResource SecondaryButton}" Height="38" MinWidth="140"
                        VerticalAlignment="Bottom" Margin="0,0,10,1"
                        Content="ใบแจ้งหนี้ล่วงหน้า"
                        Command="{Binding CreateAdvanceCommand}" />

                <Button Style="{StaticResource SecondaryButton}" Height="38" MinWidth="130"
                        VerticalAlignment="Bottom" Margin="0,0,10,1"
                        Content="พิมพ์ทั้งงวด"
                        Command="{Binding PrintPeriodCommand}" />

                <Button Style="{StaticResource DangerButton}" Height="38" MinWidth="120"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Content="ลบทั้งงวด"
                        Command="{Binding DeletePeriodCommand}" />
            </StackPanel>
        </ctl:ListPageShell.Filters>

        <ctl:ListPageShell.Table>
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <!-- เลขลำดับนับต่อเนื่องข้ามหน้า เหมือนระบบเดิม -->
                    <DataGridTemplateColumn Header="ลำดับ" Width="Auto" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RowNumber}">
                                            <Binding />
                                            <Binding Path="DataContext.Items"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.Page"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="เลขที่ใบแจ้งหนี้" Binding="{Binding InvNo}" Width="1.4*" MinWidth="160" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="บ้านเลขที่" Binding="{Binding HouseNo}" Width="*" MinWidth="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ชื่อ-นามสกุล" Binding="{Binding FullName}" Width="2*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="งวด" Binding="{Binding PeriodText}" Width="*" MinWidth="95" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ประเภท" Binding="{Binding KindText}" Width="Auto" MinWidth="100"
                                        ElementStyle="{StaticResource CenterCell}" />
                    <DataGridTextColumn Header="ค่าส่วนกลาง (บาท)" Binding="{Binding AmountDueText}" Width="Auto" MinWidth="160"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ค่าปรับ (บาท)" Binding="{Binding FineText}" Width="Auto" MinWidth="131"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ค่าทวงถาม (บาท)" Binding="{Binding CollectionFeeText}" Width="Auto" MinWidth="153"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ยอดรวม (บาท)" Binding="{Binding TotalDueText}" Width="Auto" MinWidth="140"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="สถานะ" Binding="{Binding StatusText}" Width="Auto" MinWidth="120"
                                        ElementStyle="{StaticResource CenterCell}" />

                    <DataGridTemplateColumn Header="" Width="80" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconButton}" ToolTip="พิมพ์ใบแจ้งหนี้"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrint}"
                                          Stroke="{StaticResource DeepBlueBrush}" Width="17" Height="17" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ctl:ListPageShell.Table>
    </ctl:ListPageShell>
</UserControl>
