<UserControl x:Class="AstarLiving.Client.Views.Pages.OverdueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:AstarLiving.Client.Controls"
             xmlns:pages="clr-namespace:AstarLiving.Client.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:OverduePageViewModel}">

    <ctl:ListPageShell SearchPlaceholder="ค้นหาบ้านเลขที่"
                       ShowCreate="False"
                       EmptyMessage="ไม่มีรายการค้างชำระ">

        <ctl:ListPageShell.Table>
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <!-- เลขลำดับนับต่อเนื่องข้ามหน้า เหมือนระบบเดิม -->
                    <DataGridTemplateColumn Header="ลำดับ" Width="Auto" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RowNumber}">
                                            <Binding />
                                            <Binding Path="DataContext.Items"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.Page"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="บ้านเลขที่" Binding="{Binding HouseNo}" Width="*" MinWidth="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ชื่อ-นามสกุล" Binding="{Binding FullName}" Width="2*" MinWidth="200" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="เลขที่ใบแจ้งหนี้" Binding="{Binding InvNo}" Width="1.4*" MinWidth="160" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="งวด" Binding="{Binding PeriodText}" Width="*" MinWidth="95" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="ค่าส่วนกลาง (บาท)" Binding="{Binding AmountDueText}" Width="Auto" MinWidth="160"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ค่าปรับ (บาท)" Binding="{Binding FineText}" Width="Auto" MinWidth="131"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ค่าทวงถาม (บาท)" Binding="{Binding CollectionFeeText}" Width="Auto" MinWidth="153"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="ยอดที่ต้องชำระ (บาท)" Binding="{Binding TotalDueText}" Width="Auto" MinWidth="176"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="สถานะ" Binding="{Binding StatusText}" Width="Auto" MinWidth="120"
                                        ElementStyle="{StaticResource CenterCell}" />

                    <DataGridTemplateColumn Header="" Width="170" MinWidth="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" ToolTip="พิมพ์ใบแจ้งหนี้"
                                            Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrint}"
                                              Stroke="{StaticResource DeepBlueBrush}" Width="17" Height="17" />
                                    </Button>

                                    <Button Style="{StaticResource SuccessButton}"
                                            Height="32" MinWidth="100" FontSize="{StaticResource FontSizeSm}"
                                            Margin="6,0,0,0"
                                            Content="รับชำระ"
                                            IsEnabled="{Binding CanReceive}"
                                            Command="{Binding DataContext.ReceiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ctl:ListPageShell.Table>
    </ctl:ListPageShell>
</UserControl>
